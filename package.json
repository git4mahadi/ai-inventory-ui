{
  "name": "ai-inventory-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "start:dev": "ng serve --configuration=development",
    "start:qa": "ng serve --configuration=qa",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "build:qa": "ng build --configuration=qa",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "overrides": {
    "ag-grid-angular": {
      "ag-grid-community": "$ag-grid-community"
    }
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-select/ng-select": "^21.8.2",
    "@rxweb/reactive-form-validators": "^13.0.1",
    "ag-grid-angular": "^36.1.0",
    "ag-grid-community": "^36.1.0",
    "apexcharts": "^7.0.0",
    "bootstrap": "^5.2.3",
    "jsbarcode": "^3.12.3",
    "ng-apexcharts": "^3.1.0",
    "ngx-bootstrap": "^21.2.2",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@popperjs/core": "^2.11.8",
    "@types/jsbarcode": "^3.11.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
